
# module name
# you will use this name in the code, so be considerate about naming your module.
ngx_module_name=ngx_stream_modbus_proxy_module

# ngx_addon_name
# Name of the module as it appears in output on the console from the configure script.
# You can name it differently, however we name it exactly the module name
ngx_addon_name=ngx_stream_modbus_proxy_module

# type of module to build
# possible values: 
# CORE, HTTP, HTTP_FILTER, HTTP_INIT_FILTER, HTTP_AUX_FILTER, MAIL, STREAM, or MISC.
ngx_module_type=STREAM


# the file path that you have stuffed your code in
ngx_module_srcs="$ngx_addon_dir/ngx_stream_modbus_proxy_module.c"

# $ngx_addon_dir would be defined for each module, it will be defined later

# --- External library: libmodbus ---------------------------------------------
# ngx_module_incs: extra header search paths (no -I prefix; auto/make adds it).
# ngx_module_libs: libraries to link. For a DYNAMIC module these are linked
#                  into the .so itself (auto/module -> *_LIBS -> auto/make).
# Resolved via pkg-config when available, with a sane fallback.
ngx_module_incs="$(pkg-config --cflags-only-I libmodbus 2>/dev/null | sed -e 's/-I//g')"
ngx_module_libs="$(pkg-config --libs libmodbus 2>/dev/null || echo -lmodbus)"

# process options in config file
. auto/module